# Copiar a .env local (ignorado por Git). No guardar tokens en el repositorio.
HOST=0.0.0.0
PORT=3100
# Token de lectura Wialon. Sin este valor no se realiza ninguna conexión.
WIALON_TOKEN=
WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html

# Receptor directo opcional para equipos compatibles con IPS 1.x TCP
TRACKING_INGEST_ENABLED=false
TRACKING_INGEST_HOST=127.0.0.1
TRACKING_INGEST_PORT=5101
# Destino publico a mostrar; no configura DNS, NAT ni firewall
TRACKING_PUBLIC_HOST=

# Almacenamiento local fuera de OneDrive para una instalación permanente.
# Usar rutas absolutas. Vacío mantiene data/ dentro del proyecto.
DATA_DIR=
# Vacío usa DATA_DIR/backups. Conservar y copiar toda la carpeta.
BACKUP_DIR=
# Respaldo al iniciar si corresponde y luego cada 24 h, con el servidor encendido.
# 0 deshabilita la programación, manteniendo respaldos manuales.
BACKUP_INTERVAL_HOURS=24
# Activar solo cuando el portal se sirva mediante HTTPS.
COOKIE_SECURE=false
